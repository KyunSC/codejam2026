# Copy to .env.local and fill in. Leave the key blank to run the offline stand-in model.

# Which model provider answers: anthropic (default), openai, gemini, openrouter, groq, ollama,
# or openai-compatible (any server that speaks the OpenAI Chat Completions API; set LLM_BASE_URL).
# Leave blank to pick the provider from whichever of ANTHROPIC_/OPENAI_/GEMINI_/OPENROUTER_/GROQ_API_KEY is set.
LLM_PROVIDER=
# The provider's API key. ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY and
# GROQ_API_KEY also work. Not needed for ollama.
LLM_API_KEY=
# The model id. Defaults: anthropic claude-sonnet-5-5, openai gpt-5, gemini gemini-2.5-flash.
# Required for openrouter, groq, ollama and openai-compatible.
LLM_MODEL=
# Endpoint override, ending in /v1 (e.g. http://localhost:11434/v1). Required for openai-compatible.
LLM_BASE_URL=

# Postgres for boards, sims and saved demos. Leave blank to keep them in data/*.json (local only).
# Required on Vercel, whose filesystem is read-only.
DATABASE_URL=
