# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres database (createdb brim_ap). scripts/reset-db.sh uses its name.
DATABASE_URL=postgresql://localhost/brim_ap

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me

# Claude API key for invoice extraction. Optional: extraction fails without it.
ANTHROPIC_API_KEY=

# The Harborline dataset. Relative paths resolve against Brim/.
DATASET_DIR=./brim_ap_dataset

# Where uploaded and polled attachments are stored. Relative paths resolve against Brim/.
STORAGE_DIR=./storage

# The app's "today": the dataset's as-of date. Leave as is for the demo.
AS_OF_DATE=2026-11-02

# Port the Express server listens on.
PORT=3000

# Where scripts/ingest.ts reaches the running server.
BASE_URL=http://localhost:3000

# Set to 1 to let the inbox poll pick up the sealed invoices (judges' drill only).
INCLUDE_SEALED=
