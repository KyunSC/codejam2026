# Copy to .env and fill in. Never commit .env.

# Neon pooled connection string (Neon console > Connection details > Pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Claude API key for extraction and email labelling.
ANTHROPIC_API_KEY=""

# The app's "today". Matches the dataset's as-of date; leave as is for the demo.
APP_TODAY="2026-11-02"

# Signs the pick-a-user session cookie. Any long random string.
SESSION_SECRET=""

# Vercel Blob token for uploaded files (Vercel > Storage > Blob).
BLOB_READ_WRITE_TOKEN=""
