# Copy to .env and fill in. Never commit .env.

# Neon pooled connection string (Neon console > Connection details > Pooled). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full"

# Neon direct connection string (same, with "Connection pooling" off). Used by prisma migrate.
# The Neon Vercel integration sets this name automatically.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Claude API key for extraction and email labelling.
ANTHROPIC_API_KEY=""

# The app's "today". Matches the dataset's as-of date; leave as is for the demo.
APP_TODAY="2026-11-02"

# Signs the pick-a-user session cookie. Any long random string.
SESSION_SECRET=""

# Vercel Blob token for uploaded files (Vercel > Storage > Blob).
BLOB_READ_WRITE_TOKEN=""

# Bearer token for the Brim admin API (/api/admin/*). Any long random string.
BRIM_ADMIN_TOKEN=""
